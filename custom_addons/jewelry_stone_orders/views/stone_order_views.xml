<odoo>
    <data>

        <record id="view_jewelry_stone_order_tree" model="ir.ui.view">
            <field name="name">jewelry.stone.order.tree</field>
            <field name="model">jewelry.stone.order</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="supplier_id" />
                    <field name="purpose" />
                    <field name="repair_order_id" optional="show" />
                    <field name="stones_payable" optional="show" />
                    <field name="supplier_waybill" optional="hide" />
                    <field name="fetched_at" optional="hide" />
                    <field name="shipped_complete" optional="hide" />
                    <field name="currency_id" column_invisible="1" />
                    <field name="amount_supplier" sum="Due to Supplier" optional="show"
                        widget="monetary" />
                    <field name="state"
                        decoration-muted="state in ('cancelled', 'rejected')"
                        decoration-success="state == 'received'"
                        decoration-info="state == 'shipped'"
                        widget="badge" />
                </tree>
            </field>
        </record>

        <record id="view_jewelry_stone_order_form" model="ir.ui.view">
            <field name="name">jewelry.stone.order.form</field>
            <field name="model">jewelry.stone.order</field>
            <field name="arch" type="xml">
                <form string="Stone Order">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'" />
                        <button name="action_reset_to_draft" type="object" string="Back to Draft"
                            invisible="state != 'confirmed'" />
                        <button name="action_set_in_progress" type="object" string="Taken Into Work"
                            invisible="state != 'confirmed'" />
                        <button name="action_mark_shipped" type="object" string="Shipped"
                            class="btn-primary"
                            invisible="state not in ('confirmed', 'in_progress')" />
                        <button name="action_open_reject_wizard" type="object" string="Rejected"
                            invisible="state not in ('confirmed', 'in_progress')" />
                        <button name="action_receive" type="object" string="Stones Received"
                            class="btn-primary" invisible="state != 'shipped'" />
                        <button name="action_open_transfer_wizard" type="object"
                            string="Transfer Into the Order" class="btn-primary"
                            invisible="state != 'received' or purpose != 'repair'" />
                        <button name="action_request_remainder" type="object"
                            string="Request the Remainder"
                            invisible="state != 'received' or shipped_complete" />
                        <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed', 'in_progress')" />
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,confirmed,in_progress,shipped,received" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1" /></h1>
                        </div>
                        <div class="alert alert-warning" role="alert"
                            invisible="state not in ('shipped', 'received') or shipped_complete">
                            Shipped short of what was requested — check before accepting.
                        </div>
                        <group>
                            <group>
                                <field name="supplier_id"
                                    readonly="state != 'draft'"
                                    options="{'no_create': True}" />
                                <field name="purpose" readonly="state != 'draft'" />
                                <field name="repair_order_id"
                                    invisible="purpose != 'repair'"
                                    required="purpose == 'repair'"
                                    readonly="state != 'draft'" />
                                <field name="stones_payable" readonly="state != 'draft'" />
                                <field name="commission_pct"
                                    invisible="stones_payable != 'yes'"
                                    readonly="state != 'draft'" />
                            </group>
                            <group>
                                <field name="supplier_waybill" readonly="1" />
                                <field name="fetched_at" readonly="1" />
                                <field name="last_change_at" readonly="1" />
                                <field name="shipped_complete" readonly="1"
                                    invisible="state not in ('shipped', 'received')" />
                                <field name="currency_id" invisible="1" />
                                <field name="amount_supplier" readonly="1" widget="monetary"
                                    invisible="stones_payable != 'yes'" />
                                <field name="company_id" groups="base.group_multi_company" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Requested" name="requested">
                                <field name="request_line_ids" readonly="state != 'draft'">
                                    <tree editable="bottom">
                                        <field name="gem_type_id" />
                                        <field name="origin" />
                                        <field name="cut_shape" />
                                        <field name="standard_size_id"
                                            options="{'no_create': True}" />
                                        <field name="quantity" sum="Total Qty" />
                                        <field name="weight_ct" />
                                        <field name="total_weight_ct" readonly="1"
                                            sum="Total (ct)" />
                                        <field name="certificate_ref" optional="show" />
                                    </tree>
                                </field>
                            </page>
                            <page string="Shipped" name="shipped"
                                invisible="state in ('draft', 'confirmed')">
                                <field name="shipped_line_ids">
                                    <tree editable="bottom">
                                        <field name="request_line_id"
                                            options="{'no_create': True}" optional="show" />
                                        <field name="gem_type_id" />
                                        <field name="origin" />
                                        <field name="cut_shape" optional="hide" />
                                        <field name="standard_size_id" optional="hide"
                                            options="{'no_create': True}" />
                                        <field name="certificate_ref" />
                                        <field name="quantity" sum="Total Qty" />
                                        <field name="weight_ct" />
                                        <field name="currency_id" column_invisible="1" />
                                        <field name="price_unit" widget="monetary"
                                            optional="show" />
                                        <field name="subtotal" readonly="1" widget="monetary"
                                            sum="Client Amount" optional="show" />
                                        <field name="supplier_amount" readonly="1"
                                            widget="monetary" sum="Due to Supplier"
                                            optional="hide" />
                                        <field name="disposal" optional="show" />
                                        <field name="broken_charge_to"
                                            optional="show"
                                            column_invisible="0"
                                            readonly="disposal != 'broken'" />
                                    </tree>
                                </field>
                            </page>
                            <page string="Returns" name="returns"
                                invisible="not return_ids">
                                <field name="return_ids" readonly="1">
                                    <tree>
                                        <field name="name" />
                                        <field name="return_date" />
                                        <field name="waybill" />
                                        <field name="state" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <field name="notes" placeholder="Internal notes" />
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>

        <record id="view_jewelry_stone_order_search" model="ir.ui.view">
            <field name="name">jewelry.stone.order.search</field>
            <field name="model">jewelry.stone.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="supplier_id" />
                    <field name="repair_order_id" />
                    <filter name="open" string="Open"
                        domain="[('state', 'in', ('confirmed', 'in_progress', 'shipped'))]" />
                    <filter name="received" string="Received"
                        domain="[('state', '=', 'received')]" />
                    <filter name="payable" string="Payable"
                        domain="[('stones_payable', '=', 'yes')]" />
                    <separator />
                    <filter name="for_stock" string="For Stock"
                        domain="[('purpose', '=', 'stock')]" />
                    <group expand="0" string="Group By">
                        <filter name="group_supplier" string="Supplier"
                            context="{'group_by': 'supplier_id'}" />
                        <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}" />
                        <filter name="group_repair_order" string="Repair Order"
                            context="{'group_by': 'repair_order_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="action_jewelry_stone_order" model="ir.actions.act_window">
            <field name="name">Stone Orders</field>
            <field name="res_model">jewelry.stone.order</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ── Summary: stones sitting against repair orders ───────────── -->

        <record id="view_jewelry_stone_on_hand_tree" model="ir.ui.view">
            <field name="name">jewelry.stone.order.shipped.line.on.hand.tree</field>
            <field name="model">jewelry.stone.order.shipped.line</field>
            <field name="arch" type="xml">
                <tree create="false" delete="false" edit="false">
                    <field name="order_id" />
                    <field name="gem_type_id" />
                    <field name="origin" />
                    <field name="certificate_ref" optional="show" />
                    <field name="quantity" sum="Total Qty" />
                    <field name="weight_ct" />
                    <field name="currency_id" column_invisible="1" />
                    <field name="supplier_amount" widget="monetary" sum="Due to Supplier"
                        optional="show" />
                </tree>
            </field>
        </record>

        <record id="view_jewelry_stone_on_hand_search" model="ir.ui.view">
            <field name="name">jewelry.stone.order.shipped.line.search</field>
            <field name="model">jewelry.stone.order.shipped.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="gem_type_id" />
                    <field name="certificate_ref" />
                    <group expand="1" string="Group By">
                        <filter name="group_order" string="Stone Order"
                            context="{'group_by': 'order_id'}" />
                        <filter name="group_type" string="Gem Type"
                            context="{'group_by': 'gem_type_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="action_jewelry_stones_on_hand" model="ir.actions.act_window">
            <field name="name">Stones on Hand</field>
            <field name="res_model">jewelry.stone.order.shipped.line</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_jewelry_stone_on_hand_tree" />
            <field name="search_view_id" ref="view_jewelry_stone_on_hand_search" />
            <field name="domain">[('order_id.state', '=', 'received'), ('disposal', '=', False)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No stones on hand</p>
                <p>Stones that arrived and have not been used, returned or broken.</p>
            </field>
        </record>

        <record id="action_jewelry_stones_payable" model="ir.actions.act_window">
            <field name="name">Due to Suppliers</field>
            <field name="res_model">jewelry.stone.order</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state', '=', 'received'), ('stones_payable', '=', 'yes')]</field>
            <field name="context">{'search_default_group_supplier': 1}</field>
        </record>

    </data>
</odoo>
