<odoo>
    <data>

        <record id="view_jewelry_stone_order_reject_wizard_form" model="ir.ui.view">
            <field name="name">jewelry.stone.order.reject.wizard.form</field>
            <field name="model">jewelry.stone.order.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Stone Order">
                    <group>
                        <field name="order_id" readonly="1" />
                        <field name="comment"
                            placeholder="Why the stones cannot be supplied" />
                    </group>
                    <footer>
                        <button name="action_reject" type="object" string="Reject"
                            class="btn-primary" />
                        <button special="cancel" string="Cancel" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
