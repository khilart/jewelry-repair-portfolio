<odoo>
    <data>

        <record id="view_partner_form_stone_supplier" model="ir.ui.view">
            <field name="name">res.partner.form.stone.supplier</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[@name='sales_purchases']//field[@name='ref']" position="after">
                    <field name="is_stone_supplier" />
                    <field name="stone_commission_pct"
                        invisible="not is_stone_supplier" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
