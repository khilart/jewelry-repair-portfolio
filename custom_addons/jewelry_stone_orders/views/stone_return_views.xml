<odoo>
    <data>

        <record id="view_jewelry_stone_return_tree" model="ir.ui.view">
            <field name="name">jewelry.stone.return.tree</field>
            <field name="model">jewelry.stone.return</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="return_date" />
                    <field name="supplier_id" />
                    <field name="stone_order_id" />
                    <field name="waybill" optional="show" />
                    <field name="currency_id" column_invisible="1" />
                    <field name="amount_total" widget="monetary" sum="Returned Amount" />
                    <field name="state" widget="badge"
                        decoration-success="state == 'done'" />
                </tree>
            </field>
        </record>

        <record id="view_jewelry_stone_return_form" model="ir.ui.view">
            <field name="name">jewelry.stone.return.form</field>
            <field name="model">jewelry.stone.return</field>
            <field name="arch" type="xml">
                <form string="Stone Return">
                    <header>
                        <button name="action_post" type="object" string="Post"
                            class="btn-primary" invisible="state != 'draft'" />
                        <button name="action_reset_to_draft" type="object" string="Back to Draft"
                            invisible="state != 'done'" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1" /></h1>
                        </div>
                        <group>
                            <group>
                                <field name="stone_order_id" readonly="state != 'draft'"
                                    options="{'no_create': True}" />
                                <field name="supplier_id" readonly="1" />
                            </group>
                            <group>
                                <field name="return_date" readonly="state != 'draft'" />
                                <field name="waybill" readonly="state != 'draft'" />
                                <field name="currency_id" invisible="1" />
                                <field name="amount_total" readonly="1" widget="monetary" />
                            </group>
                        </group>
                        <field name="line_ids" readonly="state != 'draft'">
                            <tree editable="bottom">
                                <field name="shipped_line_id"
                                    domain="[('order_id', '=', parent.stone_order_id), ('disposal', '=', False)]"
                                    options="{'no_create': True}" />
                                <field name="gem_type_id" readonly="1" />
                                <field name="certificate_ref" readonly="1" />
                                <field name="quantity" readonly="1" />
                                <field name="weight_ct" readonly="1" />
                            </tree>
                        </field>
                        <group>
                            <field name="notes" placeholder="Internal notes" />
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>

        <record id="action_jewelry_stone_return" model="ir.actions.act_window">
            <field name="name">Stone Returns</field>
            <field name="res_model">jewelry.stone.return</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>
