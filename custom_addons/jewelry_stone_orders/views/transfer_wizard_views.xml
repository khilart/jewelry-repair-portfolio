<odoo>
    <data>

        <record id="view_jewelry_stone_transfer_wizard_form" model="ir.ui.view">
            <field name="name">jewelry.stone.transfer.wizard.form</field>
            <field name="model">jewelry.stone.transfer.wizard</field>
            <field name="arch" type="xml">
                <form string="Transfer Stones">
                    <group>
                        <field name="order_id" readonly="1" />
                        <field name="repair_order_id" readonly="1" />
                    </group>
                    <field name="line_ids" readonly="1">
                        <tree create="false" delete="false" edit="false"
                            decoration-success="action == 'create'"
                            decoration-info="action == 'update'"
                            decoration-muted="action == 'skip'">
                            <field name="action" />
                            <field name="description" />
                            <field name="detail" />
                        </tree>
                    </field>
                    <footer>
                        <button name="action_apply" type="object" string="Transfer"
                            class="btn-primary" />
                        <button special="cancel" string="Cancel" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
