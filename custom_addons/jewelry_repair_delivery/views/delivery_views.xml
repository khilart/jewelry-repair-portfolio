<odoo>
    <data>
        <record id="view_jewelry_repair_delivery_search" model="ir.ui.view">
            <field name="name">jewelry.repair.delivery.search</field>
            <field name="model">jewelry.repair.delivery</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Delivery Number"/>
                    <field name="partner_id"/>
                    <separator/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                    <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_jewelry_repair_delivery_tree" model="ir.ui.view">
            <field name="name">jewelry.repair.delivery.tree</field>
            <field name="model">jewelry.repair.delivery</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="delivery_date"/>
                    <field name="order_count"/>
                    <field name="selected_amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_jewelry_repair_delivery_form" model="ir.ui.view">
            <field name="name">jewelry.repair.delivery.form</field>
            <field name="model">jewelry.repair.delivery</field>
            <field name="arch" type="xml">
                <form string="Repair Delivery">
                    <header>
                        <button
                            name="action_print_delivery"
                            type="object"
                            string="Print"
                            class="btn-secondary"
                        />
                        <button
                            name="action_print_delivery_grouped"
                            type="object"
                            string="Print (Grouped)"
                            class="btn-secondary"
                        />
                        <button
                            name="action_confirm"
                            type="object"
                            string="Confirm Delivery"
                            class="btn-primary"
                            invisible="state != 'draft'"
                        />
                        <button
                            name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state == 'cancel'"
                        />
                        <button
                            name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'cancel'"
                        />
                        <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="delivery_date"/>
                                <field name="selected_order_count" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="available_order_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="selected_amount_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="metal_price_per_gram" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
                                <button name="action_apply_metal_price" type="object" string="Recalculate Metal Price"
                                    class="btn-secondary" invisible="state != 'draft'"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Internal notes for the delivery"/>
                        </group>
                        <group>
                            <field
                                name="order_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <div class="d-flex gap-2 mb-2" invisible="state != 'draft'">
                            <button name="action_select_all_orders" type="object" string="Select All" class="btn-secondary"/>
                            <button name="action_clear_selected_orders" type="object" string="Clear Selection" class="btn-secondary"/>
                            <button name="action_refresh_candidates" type="object" string="Refresh Ready Orders" class="btn-secondary"/>
                        </div>
                        <field name="line_ids" readonly="state != 'draft'" nolabel="1" invisible="state != 'draft'">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="selected"/>
                                <field name="order_item_image" widget="image" options="{'size': [64, 64]}"/>
                                <field name="order_id" readonly="1" force_save="1"/>
                                <field name="order_item_type_id" readonly="1" optional="show"/>
                                <field name="order_deadline_date" readonly="1" optional="show"/>
                                <field name="order_amount_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="order_description" readonly="1" optional="show"/>
                            </tree>
                        </field>
                        <field name="confirmed_line_ids" readonly="1" nolabel="1" invisible="state == 'draft'">
                            <tree create="0" delete="0">
                                <field name="order_item_image" widget="image" options="{'size': [64, 64]}"/>
                                <field name="order_id" readonly="1"/>
                                <field name="order_item_type_id" readonly="1" optional="show"/>
                                <field name="order_deadline_date" readonly="1" optional="show"/>
                                <field name="order_amount_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="order_description" readonly="1" optional="show"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_jewelry_repair_order_form_delivery" model="ir.ui.view">
            <field name="name">jewelry.repair.order.form.delivery</field>
            <field name="model">jewelry.repair.order</field>
            <field name="inherit_id" ref="jewelry_repair_base.view_jewelry_repair_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button type="object" name="action_open_delivery"
                        class="oe_stat_button" icon="fa-truck"
                        invisible="not delivery_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Delivery</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//page[@name='additional_info']/group/group[1]" position="inside">
                    <field name="delivery_date" readonly="1"/>
                </xpath>
                <xpath expr="//page[@name='additional_info']/group/group[2]" position="inside">
                    <field name="delivery_id" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="action_jewelry_repair_delivery" model="ir.actions.act_window">
            <field name="name">Deliveries</field>
            <field name="res_model">jewelry.repair.delivery</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_jewelry_repair_delivery_search"/>
        </record>

        <!-- Pending Deliveries dashboard -->
        <record id="view_jewelry_repair_delivery_pending_tree" model="ir.ui.view">
            <field name="name">jewelry.repair.delivery.pending.tree</field>
            <field name="model">jewelry.repair.delivery.pending</field>
            <field name="arch" type="xml">
                <tree create="0" edit="0" delete="0" string="Pending Deliveries"
                      decoration-danger="is_overdue">
                    <field name="is_overdue" column_invisible="1"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="ready_order_count" string="Ready Orders"/>
                    <field name="earliest_deadline" string="Earliest Deadline"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="ready_amount" string="Amount" widget="monetary"
                           options="{'currency_field': 'currency_id'}" sum="Total"/>
                    <button name="action_create_delivery" type="object"
                            string="Create Delivery" icon="fa-plus" class="btn-primary"/>
                </tree>
            </field>
        </record>

        <record id="action_jewelry_repair_delivery_pending" model="ir.actions.act_window">
            <field name="name">Pending Deliveries</field>
            <field name="res_model">jewelry.repair.delivery.pending</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_jewelry_repair_delivery_pending_tree"/>
        </record>

        <!-- Main menu shortcuts -->
        <menuitem
            id="menu_jewelry_repair_delivery_pending"
            name="Pending Deliveries"
            parent="jewelry_repair_base.menu_jewelry_repair_root"
            action="action_jewelry_repair_delivery_pending"
            sequence="22"
            groups="jewelry_repair_base.group_jewelry_repair_receptionist,jewelry_repair_base.group_jewelry_repair_manager"
        />
        <!-- Payments section -->
        <menuitem
            id="menu_jewelry_repair_payments"
            name="Payments"
            parent="jewelry_repair_base.menu_jewelry_repair_root"
            sequence="30"
            groups="jewelry_repair_base.group_jewelry_repair_receptionist,jewelry_repair_base.group_jewelry_repair_manager,jewelry_repair_base.group_jewelry_repair_director,base.group_system"
        />
        <menuitem
            id="menu_jewelry_repair_deliveries"
            name="Deliveries"
            parent="menu_jewelry_repair_payments"
            action="action_jewelry_repair_delivery"
            sequence="10"
            groups="jewelry_repair_base.group_jewelry_repair_receptionist,jewelry_repair_base.group_jewelry_repair_manager,jewelry_repair_base.group_jewelry_repair_director,base.group_system"
        />
        <menuitem
            id="menu_jewelry_repair_delivery_pending_payments"
            name="Pending Deliveries"
            parent="menu_jewelry_repair_payments"
            action="action_jewelry_repair_delivery_pending"
            sequence="11"
            groups="jewelry_repair_base.group_jewelry_repair_receptionist,jewelry_repair_base.group_jewelry_repair_manager"
        />
    </data>
</odoo>
