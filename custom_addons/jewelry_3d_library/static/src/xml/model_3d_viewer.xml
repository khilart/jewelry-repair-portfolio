<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="jewelry_3d_library.Model3DViewer">
        <div class="o_3d_viewer d-flex flex-column" style="height: 100%; min-height: 100vh;">
            <div class="o_3d_viewer_header d-flex align-items-center gap-3 p-3 border-bottom bg-white">
                <button class="btn btn-secondary btn-sm" t-on-click="goBack">← Back</button>
                <h5 class="mb-0" t-esc="state.modelName"/>
                <span class="text-muted small ms-2">Drag to rotate · Scroll to zoom · Right-click to pan</span>
            </div>
            <div class="flex-grow-1 position-relative" style="min-height: 0;">
                <div t-if="state.loading"
                     class="position-absolute top-50 start-50 translate-middle text-muted">
                    Loading 3D model...
                </div>
                <div t-if="state.error"
                     class="position-absolute top-50 start-50 translate-middle text-danger"
                     t-esc="state.error"/>
                <canvas t-ref="canvas" style="width: 100%; height: 100%; display: block;"/>
            </div>
        </div>
    </t>
</templates>
