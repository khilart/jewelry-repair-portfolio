<odoo>
    <data>

        <record id="view_jewelry_repair_order_form_label" model="ir.ui.view">
            <field name="name">jewelry.repair.order.form.label</field>
            <field name="model">jewelry.repair.order</field>
            <field name="inherit_id" ref="jewelry_repair_base.view_jewelry_repair_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_print_order']" position="after">
                    <button name="action_print_label" type="object" string="Print Label"
                        class="btn-secondary" invisible="not id"/>
                </xpath>
            </field>
        </record>


        <record id="view_jewelry_repair_order_list_scan" model="ir.ui.view">
            <field name="name">jewelry.repair.order.list.scan</field>
            <field name="model">jewelry.repair.order</field>
            <field name="inherit_id" ref="jewelry_repair_base.view_jewelry_repair_order_list"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="js_class">jewelry_order_scan_list</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
