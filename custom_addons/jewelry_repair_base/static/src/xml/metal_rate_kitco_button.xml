<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <button
                t-if="isMetalRateList"
                type="button"
                class="btn btn-secondary"
                t-on-click="onClickFetchKitcoGold"
            >
                Fetch Gold Price from Kitco
            </button>
        </xpath>
    </t>
</templates>
