<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_jewelry_invoice" model="ir.ui.view">
        <field name="name">res.company.form.jewelry.invoice</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="after">
                <group string="Item Invoice">
                    <field name="invoice_contact_id"/>
                    <field name="invoice_payment_term_days"/>
                    <field name="invoice_payment_qr" widget="image" class="oe_avatar"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
