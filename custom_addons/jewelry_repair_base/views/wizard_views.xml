<odoo>
    <data>

        <record id="view_accept_item_wizard_form" model="ir.ui.view">
            <field name="name">jewelry.accept.item.wizard.form</field>
            <field name="model">jewelry.accept.item.wizard</field>
            <field name="arch" type="xml">
                <form string="Accept Item">
                    <group>
                        <field name="operation_id" readonly="1"/>
                        <field name="weight_before"/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Accept" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_metal_loss_report_wizard_form" model="ir.ui.view">
            <field name="name">jewelry.metal.loss.report.wizard.form</field>
            <field name="model">jewelry.metal.loss.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Metal Loss Report">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="report_type" widget="radio"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_print" type="object" string="Print" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_metal_loss_report_wizard" model="ir.actions.act_window">
            <field name="name">Metal Loss Report</field>
            <field name="res_model">jewelry.metal.loss.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_jewelry_metal_loss_report"
            name="Metal Loss"
            parent="menu_jewelry_repair_reports"
            action="action_metal_loss_report_wizard"
            sequence="20"
            groups="jewelry_repair_base.group_jewelry_repair_manager,jewelry_repair_base.group_jewelry_repair_director"
        />

        <record id="view_gem_cert_parse_wizard_form" model="ir.ui.view">
            <field name="name">jewelry.gem.cert.parse.wizard.form</field>
            <field name="model">jewelry.gem.cert.parse.wizard</field>
            <field name="arch" type="xml">
                <form string="Parse Certificate from Photo">
                    <field name="order_id" invisible="1" />
                    <field name="gem_line_id" invisible="1" />
                    <field name="state" invisible="1" />
                    <field name="pending_cert_vals" invisible="1" />

                    <!-- Step 1: upload -->
                    <div invisible="state != 'upload'"
                        class="d-flex flex-column align-items-center py-3 gap-3">
                        <p class="text-muted mb-0">
                            Upload or photograph the certificate — the record will be created and fields filled automatically.
                        </p>
                        <field name="cert_image" widget="image"
                            options="{'size': [280, 420]}" />
                    </div>

                    <!-- Step 2: duplicate found -->
                    <div invisible="state != 'duplicate'" class="py-3">
                        <div class="alert alert-warning" role="alert">
                            <strong>Certificate already exists in the system.</strong>
                            <br/>Report No.: <field name="existing_cert_id" readonly="1" />
                        </div>
                        <p>What would you like to do?</p>
                    </div>

                    <footer>
                        <!-- Step 1 footer -->
                        <button invisible="state != 'upload'"
                            name="action_parse_and_create" type="object"
                            string="Parse &amp; Save" class="btn-primary"
                            icon="fa-magic" />

                        <!-- Step 2 footer -->
                        <button invisible="state != 'duplicate'"
                            name="action_use_existing" type="object"
                            string="Use Existing" class="btn-primary" />
                        <button invisible="state != 'duplicate'"
                            name="action_create_new" type="object"
                            string="Create New" class="btn-secondary" />

                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
