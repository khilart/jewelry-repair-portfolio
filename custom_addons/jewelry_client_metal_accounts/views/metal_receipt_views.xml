<odoo>
    <data>

        <!-- ========== jewelry.client.metal.receipt ========== -->

        <record id="view_client_metal_receipt_list" model="ir.ui.view">
            <field name="name">jewelry.client.metal.receipt.list</field>
            <field name="model">jewelry.client.metal.receipt</field>
            <field name="arch" type="xml">
                <tree string="Client Metal Receipts" default_order="operation_date desc">
                    <field name="name"/>
                    <field name="operation_date"/>
                    <field name="partner_id"/>
                    <field name="metal_id"/>
                    <field name="operation_type"/>
                    <field name="storage_id" optional="show"
                        invisible="operation_type not in ('deposit_metal', 'credit_return')"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'posted'"
                        decoration-warning="state == 'draft'"
                        decoration-danger="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <record id="view_client_metal_receipt_form" model="ir.ui.view">
            <field name="name">jewelry.client.metal.receipt.form</field>
            <field name="model">jewelry.client.metal.receipt</field>
            <field name="arch" type="xml">
                <form string="Client Metal Receipt">
                    <header>
                        <button name="action_post" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                        <button name="action_cancel" string="Cancel"
                            type="object" class="btn-danger"
                            invisible="state not in ('draft', 'posted')"
                            confirm="Cancel this receipt? All linked transactions and stock movements will be cancelled."/>
                        <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object" class="btn-secondary"
                            invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,posted,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object"
                                name="action_view_transactions"
                                icon="fa-exchange"
                                invisible="not transaction_ids">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Transactions</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="object"
                                name="action_view_metal_document"
                                icon="fa-cubes"
                                invisible="not metal_document_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Metal Doc</span>
                                </div>
                            </button>
                            <field name="metal_document_id" invisible="1"/>
                            <field name="transaction_ids" invisible="1"/>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="operation_type" readonly="state != 'draft'"/>
                                <field name="partner_id" readonly="state != 'draft'"/>
                                <field name="account_id" readonly="state != 'draft'"/>
                                <field name="metal_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="operation_date" readonly="state != 'draft'"/>
                                <field name="storage_id"
                                    readonly="state != 'draft'"
                                    invisible="operation_type not in ('deposit_metal', 'credit_return')"
                                    required="operation_type in ('deposit_metal', 'credit_return')"/>
                                <field name="account_id"
                                    invisible="1"
                                    readonly="1"/>
                                <field name="account_balance_fine"
                                    string="Account Balance (fine g)"
                                    readonly="1"
                                    invisible="not account_id"
                                    class="fw-bold"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Lines" name="lines">
                                <field name="line_ids" readonly="state != 'draft'" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="alloy_id"
                                            invisible="operation_type == 'deposit_cash'"
                                            required="operation_type != 'deposit_cash'"/>
                                        <field name="weight_alloy"
                                            invisible="operation_type == 'deposit_cash'"
                                            string="Alloy (g)"/>
                                        <field name="purity"
                                            invisible="operation_type == 'deposit_cash'"
                                            optional="show"/>
                                        <field name="weight_fine" string="Fine (g)" sum="Total (g)"/>
                                        <field name="rate_datetime"
                                            invisible="operation_type not in ('deposit_metal', 'deposit_cash')"
                                            optional="show"/>
                                        <field name="rate_price_per_gram"
                                            invisible="operation_type not in ('deposit_metal', 'deposit_cash')"
                                            optional="show"
                                            widget="monetary"
                                            options="{'currency_field': 'currency_id'}"/>
                                        <field name="money_equivalent"
                                            invisible="operation_type != 'deposit_cash'"
                                            widget="monetary"
                                            options="{'currency_field': 'currency_id'}"
                                            sum="Total"/>
                                        <field name="operation_type" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="metal_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_client_metal_receipt_search" model="ir.ui.view">
            <field name="name">jewelry.client.metal.receipt.search</field>
            <field name="model">jewelry.client.metal.receipt</field>
            <field name="arch" type="xml">
                <search string="Client Metal Receipts">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="metal_id"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Metal Deposit" name="deposit_metal"
                        domain="[('operation_type', '=', 'deposit_metal')]"/>
                    <filter string="Cash Deposit" name="deposit_cash"
                        domain="[('operation_type', '=', 'deposit_cash')]"/>
                    <filter string="Metal Return" name="credit_return"
                        domain="[('operation_type', '=', 'credit_return')]"/>
                    <filter string="Adjustment" name="adjustment"
                        domain="[('operation_type', '=', 'adjustment')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Metal" name="group_metal" context="{'group_by': 'metal_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'operation_type'}"/>
                        <filter string="Month" name="group_month" context="{'group_by': 'operation_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_client_metal_receipt" model="ir.actions.act_window">
            <field name="name">Client Metal Receipts</field>
            <field name="res_model">jewelry.client.metal.receipt</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_client_metal_receipt_search"/>
        </record>

        <!-- Smart button actions -->

        <record id="action_client_metal_receipt_transactions" model="ir.actions.act_window">
            <field name="name">Transactions</field>
            <field name="res_model">jewelry.client.metal.transaction</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('receipt_id', '=', active_id)]</field>
        </record>

        <!-- Menu -->

        <menuitem
            id="menu_client_metal_receipts"
            name="Client Metal Receipts"
            parent="jewelry_repair_delivery.menu_jewelry_repair_payments"
            sequence="49"
            action="action_client_metal_receipt"/>

    </data>
</odoo>
