<odoo>
    <data noupdate="1">
        <record id="seq_jewelry_client_metal_transaction" model="ir.sequence">
            <field name="name">Client Metal Transaction</field>
            <field name="code">jewelry.client.metal.transaction</field>
            <field name="prefix">CMT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_jewelry_client_metal_receipt" model="ir.sequence">
            <field name="name">Client Metal Receipt</field>
            <field name="code">jewelry.client.metal.receipt</field>
            <field name="prefix">CMR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
