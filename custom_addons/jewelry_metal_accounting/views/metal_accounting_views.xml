        <!-- Master: metal balance for their own storage -->

        <record id="action_jewelry_master_metal_balance_server" model="ir.actions.server">
            <field name="name">My Metal Balance</field>
            <field name="model_id" ref="model_jewelry_metal_move" />
            <field name="state">code</field>
            <field name="code"><![CDATA[
executor = env['jewelry.repair.executor'].search([('user_id', '=', env.uid)], limit=1)
storage = executor.metal_storage_id if executor else False
domain = [('state', '=', 'posted')]
name = 'Metal Balance'
if storage:
    domain.append(('storage_id', '=', storage.id))
    name = storage.display_name
action = {
    'type': 'ir.actions.act_window',
    'name': name,
    'res_model': 'jewelry.metal.move',
    'view_mode': 'pivot,tree',
    'domain': domain,
    'views': [
        (env.ref('jewelry_metal_accounting.view_jewelry_metal_balance_pivot').id, 'pivot'),
        (env.ref('jewelry_metal_accounting.view_jewelry_metal_move_tree').id, 'tree'),
    ],
}
            ]]></field>
        </record>

