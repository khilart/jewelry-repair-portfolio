        <record id="view_jewelry_metal_loss_search" model="ir.ui.view">
            <field name="name">jewelry.metal.loss.search</field>
            <field name="model">jewelry.metal.loss</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="storage_id" />
                    <field name="alloy_id" />
                    <field name="metal_id" />
                    <field name="source_repair_order_id" />
                    <separator />
                    <filter name="filter_recoverable" string="Recoverable"
                        domain="[('loss_type', '=', 'recoverable')]" />
                    <filter name="filter_irrecoverable" string="Irrecoverable"
                        domain="[('loss_type', '=', 'irrecoverable')]" />
                    <filter name="filter_material" string="Material"
                        domain="[('loss_type', '=', 'material')]" />
                    <separator />
                    <filter name="filter_this_month" string="This Month"
                        domain="[('loss_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]" />
                    <group expand="0" string="Group By">
                        <filter name="group_loss_type" string="Loss Type"
                            context="{'group_by': 'loss_type'}" />
                        <filter name="group_storage" string="Storage"
                            context="{'group_by': 'storage_id'}" />
                        <filter name="group_alloy" string="Alloy" context="{'group_by': 'alloy_id'}" />
                        <filter name="group_metal" string="Metal" context="{'group_by': 'metal_id'}" />
                        <filter name="group_order" string="Repair Order"
                            context="{'group_by': 'source_repair_order_id'}" />
                        <filter name="group_month" string="Month"
                            context="{'group_by': 'loss_date:month'}" />
                    </group>
                </search>
            </field>
