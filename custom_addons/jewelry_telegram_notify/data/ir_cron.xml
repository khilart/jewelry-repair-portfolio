<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_morning_digest" model="ir.cron">
        <field name="name">Jewelry: Morning Deadline Digest for Masters</field>
        <field name="model_id" ref="jewelry_repair_base.model_jewelry_repair_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_morning_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
        <field name="nextcall">2026-04-07 07:30:00</field>
    </record>

    <record id="ir_cron_check_deadlines" model="ir.cron">
        <field name="name">Jewelry: Check Deadlines and Overdue Orders</field>
        <field name="model_id" ref="jewelry_repair_base.model_jewelry_repair_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_deadlines()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
    </record>

    <record id="ir_cron_check_master_inactivity" model="ir.cron">
        <field name="name">Jewelry: Remind Masters About Pending Operations</field>
        <field name="model_id" ref="jewelry_repair_base.model_jewelry_repair_order_operation"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_master_inactivity()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="doall">False</field>
    </record>
</odoo>
