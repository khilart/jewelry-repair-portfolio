<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_telegram" model="ir.ui.view">
        <field name="name">res.users.form.telegram</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <separator string="Telegram"/>
                <group>
                    <field name="telegram_chat_id"
                           help="Your Telegram chat ID for push notifications. Write any message to the bot, then get your ID via @userinfobot."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
